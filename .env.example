# Copy this file to .env for local settings (never commit .env).

# Admin sign-in. In development the password defaults to "betel-admin";
# in production (NODE_ENV=production) sign-in stays disabled until you set it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Long random text used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# PostgreSQL connection string. Leave empty to store everything in ./data
# (fine on your own computer). REQUIRED on Vercel, Render and similar free
# hosts, whose disks are wiped on restarts. On Vercel, connecting a Neon
# database under Storage adds it for you. Example (Neon):
# DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# The deployed address, used by the course-web export to link files that
# do not fit in the 20 MB limit (also editable in Admin > Site settings).
PUBLIC_SITE_URL=

# Optional
# PORT=3000
# MAX_UPLOAD_MB=25        # largest single file the admin can upload
# EXPORT_BUDGET_MB=20     # size limit for the course-web export
# OPTIMISE_IMAGES=true    # resize photos and save them as WebP (needs "sharp")
# DATA_DIR=data           # where local content and uploads are kept
# NODE_ENV=production
